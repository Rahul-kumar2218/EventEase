# =============================================================================
# EventEase 2026 - Backend Environment Configuration
# =============================================================================

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/eventease

# Cryptographic Secret for JWT Authentication & HMAC-SHA256 Token Signing
# Use a high-entropy string (min 32 characters)
JWT_SECRET=your_super_secret_high_entropy_jwt_key_2026

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# =============================================================================
# OPTIONAL EXTERNAL SERVICES & INTEGRATIONS
# (Platform works with built-in fallbacks/simulations when omitted)
# =============================================================================

# 1. Google Gemini AI API Key
# Enables live AI Event Assistant, Description Generation, Grounded Q&A, and Smart Recs
# Obtain from: https://aistudio.google.com/
# If omitted: Uses deterministic smart rule-based AI simulation
GEMINI_API_KEY=

# 2. Razorpay Payment Gateway Credentials
# Enables live payments, webhooks, and cryptographic signature verification
# Obtain from: https://dashboard.razorpay.com/app/keys
# If omitted: Runs in secure simulation mode for testing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

